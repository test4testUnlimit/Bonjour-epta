<Project>
  <!-- Single source of truth: repo-root VERSION -->
  <PropertyGroup>
    <_VersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)VERSION'))</_VersionFile>
    <Version Condition="Exists('$(_VersionFile)')">$([System.IO.File]::ReadAllText('$(_VersionFile)').Trim().Split('%0a')[0].Trim())</Version>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>

    <!-- Without this the shipped launcher carries the build machine's absolute
         source path — home directory and username included — in its PDB debug
         directory. Map the repo root to a stable token: reproducible, and
         leaks nothing. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
