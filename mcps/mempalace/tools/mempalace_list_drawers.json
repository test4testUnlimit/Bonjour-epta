{
  "name": "mempalace_list_drawers",
  "description": "List drawers with pagination. Optional wing/room filter. Returns IDs, wings, rooms, content previews, and total matching count for pagination.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "wing": {
        "type": "string",
        "description": "Filter by wing (optional)"
      },
      "room": {
        "type": "string",
        "description": "Filter by room (optional)"
      },
      "limit": {
        "type": "integer",
        "description": "Max results per page (default 20, max 100)",
        "minimum": 1,
        "maximum": 100
      },
      "offset": {
        "type": "integer",
        "description": "Offset for pagination (default 0)",
        "minimum": 0
      }
    }
  }
}