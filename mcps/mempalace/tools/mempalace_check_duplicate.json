{
  "name": "mempalace_check_duplicate",
  "description": "Check if content already exists in the palace before filing",
  "inputSchema": {
    "type": "object",
    "properties": {
      "content": {
        "type": "string",
        "description": "Content to check"
      },
      "threshold": {
        "type": "number",
        "description": "Similarity threshold 0-1 (default 0.9)"
      }
    },
    "required": [
      "content"
    ]
  }
}